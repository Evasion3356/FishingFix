    <ClCompile Include="src\DeadEyeFix.cpp" />
    <ClCompile Include="src\GameMemory.cpp" />
    <ClCompile Include="src\FishingFixLog.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\FishingFix.h" />
    <ClInclude Include="src\DeadEyeFix.h" />
    <ClInclude Include="src\GameMemory.h" />
    <ClInclude Include="src\FishingFixLog.h" />
  </ItemGroup>
  <PropertyGroup Label="Globals">
