  repo in as a submodule. Public headers: src/FishingFix.h,
  src/DeadEyeFix.h, src/FishingFixLog.h. Script thread only.
-->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
